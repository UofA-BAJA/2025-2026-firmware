        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-23" value="&lt;font size=&quot;1&quot;&gt;Data can be directly imported into the PostgreSQL database, assuming you have access to the server (which most people won&#39;t)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="131.5" height="87" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-24" value="&lt;font size=&quot;1&quot;&gt;Live data is gathered from the car via radio, which the client running the web app interprets&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="210" width="131.5" height="87" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kVMa-FpWhUTrMSlBEpI0-29" target="kVMa-FpWhUTrMSlBEpI0-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-29" value="&lt;font size=&quot;1&quot;&gt;The web server has a private connection to the PostgreSQL database.&amp;nbsp;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="492" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.956;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="kVMa-FpWhUTrMSlBEpI0-29" target="kVMa-FpWhUTrMSlBEpI0-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;endArrow=none;endFill=0;" edge="1" parent="1" source="kVMa-FpWhUTrMSlBEpI0-36" target="kVMa-FpWhUTrMSlBEpI0-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-36" value="&lt;font size=&quot;1&quot;&gt;The server sends database data back to the client after a successful request&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="450" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="kVMa-FpWhUTrMSlBEpI0-37" target="kVMa-FpWhUTrMSlBEpI0-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-37" value="&lt;font size=&quot;1&quot;&gt;Clients can send requests for data (queries) which will be send to the database. Clients can also provide data to be ingested in the database&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="554" width="120" height="106" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.115;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="kVMa-FpWhUTrMSlBEpI0-36" target="kVMa-FpWhUTrMSlBEpI0-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-42" value="&amp;nbsp;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kVMa-FpWhUTrMSlBEpI0-46" value="&lt;font size=&quot;1&quot;&gt;Data stored locally on the car can be ingested to the PostgreSQL database via a web app interface&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
